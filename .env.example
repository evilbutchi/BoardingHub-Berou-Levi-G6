# Copy this file to .env and fill in your own values. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local) or Supabase (Project Settings > Database > Connection string)
DB_NAME=boardinghub
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
# Supabase usually requires SSL; use "require" there, "prefer" for local Postgres
DB_SSLMODE=prefer
